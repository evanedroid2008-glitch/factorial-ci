{
  "name": "factorial-ci",
  "version": "1.0.0",
  "description": "Factorial generator (BigInt) with tests and a GitHub Actions CI pipeline",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/server.js",
    "cli": "node src/cli.js",
    "test": "node --test test/factorial.test.js test/server.test.js",
    "test:watch": "node --test --watch test/factorial.test.js test/server.test.js"
  },
  "keywords": ["factorial", "bigint", "ci-cd", "github-actions", "node-test"],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
